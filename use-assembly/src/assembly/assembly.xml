<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>use-bin</id>
    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/../</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>README*</include>
                <include>ChangeLog*</include>
                <include>COPYING*</include>
                <include>INSTALL*</include>
                <include>NEWS*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Script files to easily start USE -->
            <directory>${project.basedir}/../use-gui/src/main/resources/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Script files to easily start USE -->
            <directory>${project.basedir}/../use-core/src/main/resources/etc</directory>
            <outputDirectory>etc</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- OCL extensions defined in Ruby -->
            <directory>${project.basedir}/../use-core/src/main/resources/oclextensions/</directory>
            <outputDirectory>oclextensions</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Directory with models from publications and examples -->
            <directory>${project.basedir}/../use-core/src/main/resources/examples/</directory>
            <outputDirectory>examples</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- This file is not really necessary, but including it allows for an easy usage as a library -->
            <directory>${project.basedir}/../use-core/target</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- This is the most important file. -->
            <directory>${project.basedir}/../use-gui/target</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>use-gui.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Plugins that should be shipped with the USE archive are located here -->
            <directory>${project.basedir}/src/main/resources/plugins</directory>
            <outputDirectory>lib/plugins</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Modernized Kodkod Model Validator, built from source in this reactor rather than
                 vendored as a static binary (see docs/kk-modelvalidator-port.md). Supersedes the
                 vendored ModelValidatorPlugin-5.2.0-r1.jar removed from
                 src/main/resources/plugins/, which crashes against this fork's USE API
                 (NoSuchMethodError, confirmed and documented). -->
            <directory>${project.basedir}/../msc-modelvalidators/kk-modelvalidator/target</directory>
            <outputDirectory>lib/plugins</outputDirectory>
            <includes>
                <include>KK-ModelValidator-1.0.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../msc-modelvalidators/unc-modelvalidator/target</directory>
            <outputDirectory>lib/plugins</outputDirectory>
            <includes>
                <include>unc-modelvalidator-7.5.0-plugin.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Runnable, verified KK-ModelValidator examples (see
                 benchmark/examples/README.md), covering plugin commands the
                 main USE examples above never exercise: mv -validate, -invIndep,
                 -scrollingAll, and the OCL query mechanism against a relational
                 solution. Lives under benchmark/ (not kk-modelvalidator/) since this same
                 example corpus is also the benchmark module's own scenario suite, shared
                 between "run these interactively" (this fileSet) and "run these headlessly
                 and compare solvers" (benchmark/scripts/run-benchmark.sh); moved here to make
                 the benchmark module self-contained and independently shareable. -->
            <directory>${project.basedir}/../msc-modelvalidators/benchmark/examples</directory>
            <outputDirectory>examples/KK-ModelValidator</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet>
            <!-- Vendored native SAT solvers (see kk-modelvalidator/vendored-solvers/README.md):
                 same files the original plugin's own `-downloadSolvers` command fetches at
                 runtime, vendored for reproducibility. Placed at the exact path
                 KodkodModelValidatorConfiguration.getSolverFolder() already expects
                 (lib/plugins/modelValidatorPlugin/x64), so both a fresh `-downloadSolvers` run
                 and this vendored copy agree on where solvers live. bin/use and
                 examples/run-example.sh point -Djava.library.path here so `-config satsolver :=
                 MiniSat` (etc.) works without any extra flag. -->
            <directory>${project.basedir}/../msc-modelvalidators/kk-modelvalidator/vendored-solvers/x64</directory>
            <outputDirectory>lib/plugins/modelValidatorPlugin/x64</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <!-- javafx sdk that should be shipped with the USE archive is located here -->
            <directory>${project.basedir}/../use-gui/lib/javafx-sdk-21.0.5</directory>
            <outputDirectory>lib/javafx-sdk-21.0.5</outputDirectory>
            <includes>
                <include>lib/**</include>
                <include>bin/**</include>
                <include>legal/**</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
