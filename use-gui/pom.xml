    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.8.2</junit.version>
        <lombok.version>1.18.42</lombok.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Flipped to true ONLY by the upstream-oracle profile below.  The floor check
             compares it against ${session.request.activeProfiles}, which is the reactor-wide
             -P list from the command line and cannot be changed by editing this file: that is
             how "profile requested but not effective in this module" becomes an error. -->
        <use.upstreamOracle.effective>false</use.upstreamOracle.effective>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.tzi.use.main.gui.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Class-Path>../lib/</Class-Path>
                        </manifestEntries>
                    </archive>
                    <finalName>use-gui</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id> <!-- this is used for inheritance merges -->
                        <phase>package</phase> <!-- bind to the packaging phase -->
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>1.5</version>
                <executions>
                    <execution>
                        <id>add-test-source</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/it/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-resource</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/it/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>2.22.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>org.tzi.use.main.gui.Main</mainClass>
                </configuration>
            </plugin>
            <!-- ==========================================================================
                 THE ASSERTED FLOOR of the acceptance gate (static-review defect D-01).
                 use-gui's 8 classes / 17 methods are the population D-01's merge accident
                 deletes, and ground rule 2 forbids adding a test under use-gui/src, so the
                 floor for THIS module is asserted from the build, by the same checker
                 use-core runs.  Declared in the DEFAULT build, not in the profile, so it
                 runs in both modes.  See scripts/UpstreamOracleFloor.java.

                 EVERY SILENCING PROPERTY IS PINNED (round 11, defect F-01 of
                 docs/port2/upstream-oracle-floor-verification.md): <skip>false</skip> alone
                 was not enough, because `-Dexec.args=-version` REPLACED the argument list
                 and produced a green build with zero [floor] lines.  The seven pins below,
                 the reason each one exists, and why <commandlineArgs> must stay on one line
                 with relative paths, are documented in full in use-core/pom.xml — the two
                 blocks are deliberately identical apart from the "module=" option value
                 (an XML comment may not contain two adjacent dashes).  Both this pom and
                 use-core's are asserted, on every run, by the checker itself AND by
                 use-core/src/test/java/org/tzi/use/uncertainty/gate/
                 UpstreamOracleGateWiringTest.java, which no exec-maven-plugin property can
                 silence.  A test in use-core cannot see this module's classpath or reports,
                 so it asserts this module's WIRING only; the counts stay with the build.
                 ========================================================================== -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The initialize-phase execution does TWO things (round 12, defect
                         G-04 of docs/port2/upstream-oracle-gate-round11.md sec. 5): it writes
                         the freshness stamp, AND it fails the build on a requested -P id that
                         no pom in this reactor declares.  The second one lives HERE, at
                         `initialize`, and not only at `verify`, because a TRUNCATED LIFECYCLE
                         outruns a verify-phase gate:
                             mvn -B test -Pupstream-oracle-typo   ->  BUILD SUCCESS, exit 0,
                         no floor check at all and the typo one [WARNING] in a 1393-line log.
                         `initialize` is the second phase of the default lifecycle, so every
                         lifecycle a developer can truncate to still reaches it.  That is why
                         this execution now also carries reactor-root, requested and
                         allow-profiles; scripts/UpstreamOracleFloor.java asserts, in check A,
                         that each of those three appears TWICE in this pom.  See also
                         docs/port2/gate-threat-model.md. -->
                    <execution>
                        <id>upstream-oracle-floor-stamp</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <async>false</async>
                            <timeout>0</timeout>
                            <quietLogs>false</quietLogs>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <commandlineArgs>../scripts/UpstreamOracleFloor.java --stamp=true --module-dir=. --reactor-root=.. --requested=${session.request.activeProfiles} --allow-profiles=${use.floor.allowProfiles}</commandlineArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>upstream-oracle-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <async>false</async>
                            <timeout>0</timeout>
                            <quietLogs>false</quietLogs>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <commandlineArgs>../scripts/UpstreamOracleFloor.java --module=use-gui --module-dir=. --reactor-root=.. --effective=${use.upstreamOracle.effective} --selected=${session.request.selectedProjects} --resume-from=${session.request.resumeFrom} --requested=${session.request.activeProfiles} --allow-profiles=${use.floor.allowProfiles} --exec-args=${exec.args} --exec-skip=${exec.skip} --exec-async=${exec.async} --exec-timeout=${exec.timeout} --exec-executable=${exec.executable} --exec-outputfile=${exec.outputFile} --exec-quietlogs=${exec.quietLogs} --exec-workingdir=${exec.workingdir}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ==================================================================================
         -Pupstream-oracle  (decision B3, 2026-08-17)

         Adds junit-vintage-engine at TEST scope, and nothing else.  Upstream USE's own test
         tree is overwhelmingly JUnit 3 (junit.framework.TestCase) and JUnit 4
         (org.junit.Test); this reactor declares only junit-jupiter, so surefire's JUnit
         Platform discovers none of it.  Those files are neither skipped nor reported; they
         are never collected, which is why the default build runs 3 test classes out of the
         41 *Test.java files present (docs/port2/stage-00-baseline.md sec. 3).

         With this profile active they execute EXACTLY AS UPSTREAM WROTE THEM.  No upstream
         test file is edited, migrated or renamed by this port: that is the entire reason a
         profile was chosen over a JUnit 5 migration.  The previous port migrated them by
         hand (TypeTest.java at +1172/-1096), which re-authored the oracle with the same
         change it was meant to judge.

         The profile is OFF by default so that the product build keeps the specified
         toolchain (JUnit 5 Jupiter, no vintage engine).  From S3 onwards every stage's
         acceptance runs BOTH:

             mvn -B verify -Djava.awt.headless=true
             mvn -B verify -Pupstream-oracle -Djava.awt.headless=true

         See docs/port2/upstream-oracle-profile.md.
         ================================================================================== -->
    <profiles>
        <profile>
            <id>upstream-oracle</id>
            <properties>
                <use.upstreamOracle.effective>true</use.upstreamOracle.effective>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                    <version>5.7.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>