<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tzi.use</groupId>
        <artifactId>use</artifactId>
        <version>7.5.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>use-core</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Flipped to true ONLY by the upstream-oracle profile below.  The floor check
             compares it against ${session.request.activeProfiles}, which is the reactor-wide
             -P list from the command line and cannot be changed by editing this file: that is
             how "profile requested but not effective in this module" becomes an error. -->
        <use.upstreamOracle.effective>false</use.upstreamOracle.effective>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.5.0-jre</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jdt</groupId>
            <artifactId>org.eclipse.jdt.annotation</artifactId>
            <version>2.2.600</version>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr-runtime</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>jline</groupId>
            <artifactId>jline</artifactId>
            <version>2.14.6</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.combinatoricslib</groupId>
            <artifactId>combinatoricslib</artifactId>
            <version>2.3</version>
        </dependency>
        <dependency>
            <groupId>org.jruby</groupId>
            <artifactId>jruby-core</artifactId>
            <version>9.3.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.ximpleware</groupId>
            <artifactId>vtd-xml</artifactId>
            <version>2.13.4</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava-testlib</artifactId>
            <version>33.5.0-jre</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.bekioui.maven.plugin</groupId>
                <artifactId>merge-maven-plugin</artifactId>
                <version>1.2.0</version>
                <executions>
                    <execution>
                        <id>merge-grammar-files</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <merges>
                                <merge>
                                    <!-- Merge OCL grammar -->
                                    <target>${project.build.directory}/grammars/OCL.g</target>
                                    <sources>
                                        <source>src/main/resources/grammars/ocl/OCL.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                                <merge>
                                    <!-- Merge SOIL grammar -->
                                    <target>${project.build.directory}/grammars/Soil.g</target>
                                    <sources>
                                        <source>src/main/resources/grammars/soil/Soil.gpart</source>
                                        <source>src/main/resources/grammars/base/SoilBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                                <merge>
                                    <!-- Merge USE grammar -->
                                    <target>${project.build.directory}/grammars/USE.g</target>
                                    <sources>
                                        <source>src/main/resources/grammars/use/USE.gpart</source>
                                        <source>src/main/resources/grammars/base/USEBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>src/main/resources/grammars/base/SoilBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                                <merge>
                                    <!-- Merge Shell grammar -->
                                    <target>${project.build.directory}/grammars/ShellCommand.g</target>
                                    <sources>
                                        <source>src/main/resources/grammars/shell/ShellCommand.gpart</source>
                                        <source>
                                            src/main/resources/grammars/base/ShellCommandBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>src/main/resources/grammars/base/SoilBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                                <merge>
                                    <!-- Merge Generator grammar -->
                                    <target>${project.build.directory}/grammars/Generator.g</target>
                                    <sources>
                                        <source>
                                            src/main/resources/grammars/generator/Generator.gpart</source>
                                        <source>src/main/resources/grammars/base/USEBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>src/main/resources/grammars/base/SoilBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                                <merge>
                                    <!-- Merge test suite grammar -->
                                    <target>${project.build.directory}/grammars/TestSuite.g</target>
                                    <sources>
                                        <source>
                                            src/main/resources/grammars/testsuite/TestSuite.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLBase.gpart</source>
                                        <source>
                                            src/main/resources/grammars/base/ShellCommandBase.gpart</source>
                                        <source>src/main/resources/grammars/base/SoilBase.gpart</source>
                                        <source>src/main/resources/grammars/base/OCLLexerRules.gpart</source>
                                    </sources>
                                    <override>true</override>
                                </merge>
                            </merges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr3-maven-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!--<debug>true</debug>-->
                    <!-- print some fancy information about the grammars-->
                    <report>false</report>
                    <!-- generated parser code will log rule entry and exit points to
                    stdout as an aid to debugging.-->
                    <trace>false</trace>
                    <!--   generate a dot graph of the NFA for each rule -->
                    <!-- <nfa>true</nfa> -->
                    <!-- generate a dot graph of the DFA for each decision in the grammar
                    -->
                    <!-- <dfa>true</dfa> -->
                    <sourceDirectory>target/grammars</sourceDirectory>
                    <verbose>false</verbose>
                </configuration>
                <executions>
                    <execution>
                        <id>antlr</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>antlr</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.coderplus.maven.plugins</groupId>
                <artifactId>copy-rename-maven-plugin</artifactId>
                <version>1.0</version>
                <executions>
                    <execution>
                        <id>move-antlr-parser-use</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>rename</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/USELexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/use/USELexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/USEParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/use/USEParser.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/GeneratorLexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/generator/GeneratorLexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/GeneratorParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/generator/GeneratorParser.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/OCLLexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/ocl/OCLLexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/OCLParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/ocl/OCLParser.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>
                                        target/generated-sources/antlr3/ShellCommandLexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/shell/ShellCommandLexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>
                                        target/generated-sources/antlr3/ShellCommandParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/shell/ShellCommandParser.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/SoilLexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/soil/SoilLexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/SoilParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/soil/SoilParser.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/TestSuiteLexer.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/testsuite/TestSuiteLexer.java</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>target/generated-sources/antlr3/TestSuiteParser.java</sourceFile>
                                    <destinationFile>
                                        target/generated-sources/antlr3/org/tzi/use/parser/testsuite/TestSuiteParser.java</destinationFile>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-test-source</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/it/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-antlr3-generated-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>target/generated-sources/antlr3</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>2.22.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <tags>
                        <tag>
                            <name>ocl.pre</name>
                            <placement>m</placement>
                            <head>Precondition:</head>
                        </tag>
                    </tags>
                </configuration>
            </plugin>
            <!-- ==========================================================================
                 THE ASSERTED FLOOR of the acceptance gate (static-review defect D-01).
                 Declared in the DEFAULT build, not in the profile, so it runs on every
                 `mvn verify` in both modes and cannot be removed by deleting a profile
                 block.  <skip>false</skip> is pinned here so -Dexec.skip cannot silence it.
                 Runs after maven-failsafe-plugin's `verify` goal (declared above), so both
                 report tiers exist.  See scripts/UpstreamOracleFloor.java and
                 docs/port2/upstream-oracle-profile.md sec. 5.
                 ========================================================================== -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>upstream-oracle-floor-stamp</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/UpstreamOracleFloor.java</argument>
                                <argument>--stamp=true</argument>
                                <argument>--module-dir=${project.basedir}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>upstream-oracle-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/UpstreamOracleFloor.java</argument>
                                <argument>--module=use-core</argument>
                                <argument>--module-dir=${project.basedir}</argument>
                                <argument>--reactor-root=${project.basedir}/..</argument>
                                <argument>--requested=${session.request.activeProfiles}</argument>
                                <argument>--effective=${use.upstreamOracle.effective}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ==================================================================================
         -Pupstream-oracle  (decision B3, 2026-08-17)

         Adds junit-vintage-engine at TEST scope, and nothing else.  Upstream USE's own test
         tree is overwhelmingly JUnit 3 (junit.framework.TestCase) and JUnit 4
         (org.junit.Test); this reactor declares only junit-jupiter, so surefire's JUnit
         Platform discovers none of it.  Those files are neither skipped nor reported; they
         are never collected, which is why the default build runs 3 test classes out of the
         41 *Test.java files present (docs/port2/stage-00-baseline.md sec. 3).

         With this profile active they execute EXACTLY AS UPSTREAM WROTE THEM.  No upstream
         test file is edited, migrated or renamed by this port: that is the entire reason a
         profile was chosen over a JUnit 5 migration.  The previous port migrated them by
         hand (TypeTest.java at +1172/-1096), which re-authored the oracle with the same
         change it was meant to judge.

         The profile is OFF by default so that the product build keeps the specified
         toolchain (JUnit 5 Jupiter, no vintage engine).  From S3 onwards every stage's
         acceptance runs BOTH:

             mvn -B verify -Djava.awt.headless=true
             mvn -B verify -Pupstream-oracle -Djava.awt.headless=true

         See docs/port2/upstream-oracle-profile.md.
         ================================================================================== -->
    <profiles>
        <profile>
            <id>upstream-oracle</id>
            <properties>
                <use.upstreamOracle.effective>true</use.upstreamOracle.effective>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                    <version>5.7.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>