!create Square3 : Square
!set Square3.index := 3
!create Square4 : Square
!set Square4.index := 4
!create Square5 : Square
!set Square5.index := 5
!create Square6 : Square
!set Square6.index := 6

!create Field1 : Field
!set Field1.value := 5
