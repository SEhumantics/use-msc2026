-- Same hand-built instance as valid-instance.soil, EXCEPT DBforDummies.year
-- is set to 1400 instead of 2000. 1400 < 1455, so this deliberately
-- violates Book_yearPlausible (context b:Book inv yearPlausible:
-- 1455<=b.year) for that one Book object, while leaving every other
-- invariant in Library.properties' active set satisfied -- see
-- invalid-instance.cmd.

!create Ada : User
!set Ada.name := 'Ada'
!set Ada.address := 'NY'

!create Bob : User
!set Bob.name := 'Bob'
!set Bob.address := 'CA'

!create DBforDummies : Book
!set DBforDummies.title := 'DBforDummies'
!set DBforDummies.auth := 'Ada'
!set DBforDummies.year := 1400

!create IntroToAI : Book
!set IntroToAI.title := 'IntroToAI'
!set IntroToAI.auth := 'Bob'
!set IntroToAI.year := 2005

!create DBS42 : Copy
!set DBS42.signature := 'DBS42'
!set DBS42.numReturns := 0

!create NW21 : Copy
!set NW21.signature := 'NW21'
!set NW21.numReturns := 2

!insert (DBS42, DBforDummies) into BelongsTo
!insert (NW21, IntroToAI) into BelongsTo

!insert (Ada, DBS42) into Borrows
!insert (Bob, NW21) into Borrows
