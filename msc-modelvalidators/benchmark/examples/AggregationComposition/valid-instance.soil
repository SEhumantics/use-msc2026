-- Hand-built, deliberately VALID instance of FileSystem, constructed with
-- plain USE SOIL statements (no Kodkod search involved). Loaded via the
-- plain USE shell `open' command, exactly like Genealogy/partial-state.soil.
--
-- Structure (4 objects):
--   f1 : Folder 'root'   -- a root folder, no primaryParent
--   f2 : Folder 'docs'   -- f2.primaryParent = f1 (real PrimaryContains link,
--                           so notOwnPrimaryParent is checked against an
--                           actual value, not just an unset/undefined one)
--   a1 : Archive 'archive1'
--   m1 : MediaFile 'song.mp3', size=2048, codec='mp3'
--        -- m1.ownerArchive = a1 via ArchiveHasMedia only (no FolderHasFile
--           link on m1 at all, so there is no double ownership here)
--
-- Every invariant in FileSystem.use should hold: nameNotEmpty (f1, f2),
-- sizePositive (m1, via the inherited File.size attribute), Archive's
-- nameNotEmpty (a1), and notOwnPrimaryParent (both f1 and f2).

!create f1 : Folder
!set f1.name := 'root'

!create f2 : Folder
!set f2.name := 'docs'

!insert (f1, f2) into PrimaryContains

!create a1 : Archive
!set a1.name := 'archive1'

!create m1 : MediaFile
!set m1.name := 'song.mp3'
!set m1.size := 2048
!set m1.codec := 'mp3'

!insert (a1, m1) into ArchiveHasMedia
