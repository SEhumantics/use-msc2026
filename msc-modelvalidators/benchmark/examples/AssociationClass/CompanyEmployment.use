model CompanyEmployment

-- An ASSOCIATION CLASS: Employment attaches salary/startDate attributes
-- directly to the *link* between Person and Company, not to either endpoint
-- class. org.tzi.kodkod.model.impl.AssociationClass / IAssociationClass
-- implement this feature in the plugin, but -- per the plugin's own
-- history -- it had never been covered by a single example or unit test
-- before this one.

class Person
attributes
  name : String
end

class Company
attributes
  name   : String
  budget : Integer
end

associationclass Employment between
  Person  [0..*] role employee
  Company [0..1] role employer
attributes
  salary    : Integer
  startDate : Integer
end

-- Multiplicities: a Company can have any number of employees (0..*), and a
-- Person is employed by at most one Company at a time (0..1 -- so a Person
-- may also be unemployed, with no Employment link at all). Confirmed
-- empirically (see README) that this also caps the number of reachable
-- Employment link objects per Person at exactly 0 or 1 -- USE typed
-- `person.employment` as a single Employment, not Set(Employment), because
-- an ordinary (unqualified) binary association allows at most one link per
-- participant pair, same rule an association class inherits.

constraints

-- 1./2. Plain attribute invariants, but their context is the LINK itself,
-- not either endpoint class -- only possible because Employment is an
-- association class.
context e:Employment inv PositiveSalary:
  e.salary > 0

context e:Employment inv StartDateNotNegative:
  e.startDate >= 0

-- 3. A genuine cross-attribute invariant that can only be expressed by
-- reaching through the association class: `salary` lives on Employment,
-- `budget` lives on Company, and the two are tied together via
-- `e.employer`.
context e:Employment inv SalaryBelowEmployerBudget:
  e.salary < e.employer.budget

-- 4. Every Employment instance always has both ends bound (that is what
-- being a link *is*) -- expected to be a structural tautology forced by the
-- association-class machinery itself, not by any other declared invariant
-- here. See invIndep.cmd for whether -invIndep actually reports this as
-- "not independent" and, if so, for what reason.
context e:Employment inv EmployeeAndEmployerAlwaysLinked:
  e.employee <> null and e.employer <> null

-- 5. Restates the Company[0..1] end multiplicity as an explicit OCL
-- invariant, to see whether -invIndep flags it as redundant with a
-- MULTIPLICITY constraint rather than with another OCL invariant -- a
-- different flavor of "not independent" than EmployeeInvariants'
-- (invariant-implies-invariant) or CompanyERSchema's (invariant implied
-- by several others combined).
context p:Person inv AtMostOneEmployer:
  p.employer->size() <= 1
