model TinyBadConfig

-- Deliberately trivial fixture for BenchmarkRunnerErrorPathTest: its ONLY purpose is to give
-- TinyBadConfig.properties' [bad] section an association line
-- (AB = Set{(a1,doesnotexist)}) referencing an object id that was never declared for B, so
-- PropertyConfigurationVisitor.visitAssociation -> checkComplexElement -> complexElementError
-- fires a real config error and containErrors() genuinely returns true -- reproducing
-- BenchmarkRunner.runOne's early-return path (BUG B) with real compiled code, not a mock.

class A
attributes
  i : Integer
end

class B
end

association AB between
  A[1] role a
  B[1] role b
end

constraints

context a : A inv Dummy: a.i > 0
