model URealPairwise

class Sensor
attributes
  speedA : UReal
  speedB : UReal
  countA : UInteger
  countB : UInteger
end

constraints

context s : Sensor inv aBelowB:
  (s.speedA < s.speedB).toBooleanC(0.9)

context s : Sensor inv aAboveB:
  (s.speedA > s.speedB).toBooleanC(0.9)

context s : Sensor inv aAtMostB:
  (s.speedA <= s.speedB).toBooleanC(0.9)

context s : Sensor inv tightSigma:
  (s.speedA < s.speedB).toBooleanC(0.999)

context s : Sensor inv uCountBelow:
  (s.countA < s.countB).toBooleanC(0.8)

context s : Sensor inv uCountTight:
  (s.countA < s.countB).toBooleanC(0.9)
