model LetScope

class A
attributes
  i : Integer
  j : Integer
end

class Holder
attributes
  target : Integer
  limit : Integer
end

class Candidate
attributes
  key : Integer
  value : Integer
end

constraints

context a : A inv primitiveLet:
  let threshold : Integer = a.i + 1 in
    threshold > a.j

context a : A inv undefinedLet:
  let threshold : Integer = oclUndefined(Integer) in
    threshold > 0

context a : A inv equalityLet:
  let copy : Integer = a.i in
    copy = a.j

context a : A inv objectLet:
  let chosen : A = A.allInstances()->any(x | x.i = a.i) in
    chosen.i > 0

context a : A inv collectionLet:
  let chosen : Set(A) = A.allInstances() in
    chosen->isEmpty()

context h : Holder inv objectAnyLet:
  let chosen : Candidate = Candidate.allInstances()->any(c | c.key = h.target) in
    chosen.value > h.limit
