-- Same shape as valid-instance.soil (2 Person, 2 Company, one Employment
-- link per Person), but adaEmployment.salary is set to -100 -- a negative
-- salary -- to deliberately violate exactly ONE invariant:
--
--   Employment::PositiveSalary (e.salary > 0) -- VIOLATED for adaEmployment.
--
-- Every other invariant that still applies to this state remains satisfied:
--   StartDateNotNegative      : both startDates (5, 10) are >= 0.
--   SalaryBelowEmployerBudget : -100 < 100000 and 20000 < 50000 both hold --
--     a negative salary is still (trivially) below the employer's budget,
--     so this invariant is NOT the one that fails here.
--   EmployeeAndEmployerAlwaysLinked : trivially true, unaffected by salary.
--   AtMostOneEmployer         : each Person still has exactly one Employment.
--
-- Structurally this is still a fully valid Employment link object (both
-- ends bound, association-class multiplicities respected) -- only the
-- OCL attribute invariant on `salary' fails, not SOIL-level construction.

!create ada : Person
!set ada.name := 'Ada'

!create bob : Person
!set bob.name := 'Bob'

!create acme : Company
!set acme.name := 'Acme'
!set acme.budget := 100000

!create globex : Company
!set globex.name := 'Globex'
!set globex.budget := 50000

!create adaEmployment : Employment between (ada, acme)
!set adaEmployment.salary := -100
!set adaEmployment.startDate := 5

!create bobEmployment : Employment between (bob, globex)
!set bobEmployment.salary := 20000
!set bobEmployment.startDate := 10
